# Dependencies
**/node_modules/

# Build output
**/dist/
**/build/
**/coverage/
**/.nyc_output/
**/*.tsbuildinfo

# Environment variables and secrets
**/.env
**/.env.*
!**/.env.example
!**/.env.*.example

# Logs and diagnostics
**/logs/
**/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime and temporary files
**/.temp/
**/.tmp/
**/tmp/
**/temp/
**/pids/
*.pid
*.pid.lock
*.seed

# OS and editor files
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.sublime-workspace
*.code-workspace

# Deployment and tooling caches
.vercel/
.netlify/
.turbo/
.cache/